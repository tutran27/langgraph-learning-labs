# API Keys for LLM Providers (Điền key của bạn vào đây)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# LangSmith Tracing & Observability (Giám sát luồng chạy Agent)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-learning-labs

# Cấu hình môi trường dự án
ENVIRONMENT=development
DATABASE_URL=sqlite:///./state_db.sqlite
